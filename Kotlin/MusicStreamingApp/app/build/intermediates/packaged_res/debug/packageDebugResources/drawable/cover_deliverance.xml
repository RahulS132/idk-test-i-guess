<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#000000"
                android:centerColor="#1c1c1c"
                android:endColor="#3a2e2a"
                android:type="linear" />
            <corners android:radius="@dimen/album_cover_corner" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="250"
                android:centerX="0.5"
                android:centerY="0.7"
                android:startColor="#666e3b25"
                android:endColor="#00000000" />
            <corners android:radius="@dimen/album_cover_corner" />
        </shape>
    </item>
</layer-list>
