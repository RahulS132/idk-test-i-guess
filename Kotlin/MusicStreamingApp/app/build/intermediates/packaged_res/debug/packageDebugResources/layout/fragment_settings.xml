<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink_black"
    tools:context=".ui.SettingsFragment">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/settingsToolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/spacing_lg"
        android:background="@android:color/transparent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationContentDescription="@string/cd_back"
        app:navigationIcon="@drawable/ic_back"
        app:navigationIconTint="@color/alabaster_grey"
        app:title="@string/title_settings"
        app:titleTextColor="@color/alabaster_grey" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingHorizontal="@dimen/spacing_md"
        android:paddingTop="@dimen/spacing_lg"
        android:paddingBottom="@dimen/spacing_xxl"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/settingsToolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ACCOUNT GROUP -->
            <TextView
                style="@style/TextAppearance.MusicStream.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_sm"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/group_account"
                android:textAllCaps="true"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.MusicStream.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/rowEditProfile"
                        layout="@layout/include_settings_row" />

                    <View style="@style/Divider.MusicStream" />

                    <include
                        android:id="@+id/rowChangePassword"
                        layout="@layout/include_settings_row" />

                    <View style="@style/Divider.MusicStream" />

                    <include
                        android:id="@+id/rowLogout"
                        layout="@layout/include_settings_row" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- PLAYBACK GROUP -->
            <TextView
                style="@style/TextAppearance.MusicStream.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_sm"
                android:layout_marginTop="@dimen/spacing_lg"
                android:text="@string/group_playback"
                android:textAllCaps="true"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.MusicStream.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/rowAudioQuality"
                        layout="@layout/include_settings_row_value" />

                    <View style="@style/Divider.MusicStream" />

                    <include
                        android:id="@+id/rowDownloadWifi"
                        layout="@layout/include_settings_row_switch" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- NOTIFICATIONS GROUP -->
            <TextView
                style="@style/TextAppearance.MusicStream.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_sm"
                android:layout_marginTop="@dimen/spacing_lg"
                android:text="@string/group_notifications"
                android:textAllCaps="true"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.MusicStream.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm">

                <include
                    android:id="@+id/rowPushNotifications"
                    layout="@layout/include_settings_row_switch" />
            </com.google.android.material.card.MaterialCardView>

            <!-- APPEARANCE GROUP -->
            <TextView
                style="@style/TextAppearance.MusicStream.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_sm"
                android:layout_marginTop="@dimen/spacing_lg"
                android:text="@string/group_appearance"
                android:textAllCaps="true"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.MusicStream.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm">

                <include
                    android:id="@+id/rowTheme"
                    layout="@layout/include_settings_row_value" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
