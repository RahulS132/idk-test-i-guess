<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#1a0e0a"
                android:centerColor="#3d2818"
                android:endColor="#8b6f47"
                android:type="linear" />
            <corners android:radius="@dimen/album_cover_corner" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="180"
                android:centerX="0.5"
                android:centerY="0.5"
                android:startColor="#55d4a574"
                android:endColor="#00000000" />
            <corners android:radius="@dimen/album_cover_corner" />
        </shape>
    </item>
</layer-list>
