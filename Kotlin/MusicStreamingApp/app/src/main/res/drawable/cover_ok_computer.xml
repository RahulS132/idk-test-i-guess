<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="180"
                android:startColor="#dcdcd2"
                android:centerColor="#a8a89c"
                android:endColor="#5e6360"
                android:type="linear" />
            <corners android:radius="@dimen/album_cover_corner" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="200"
                android:centerX="0.5"
                android:centerY="0.5"
                android:startColor="#33ffffff"
                android:endColor="#00000000" />
            <corners android:radius="@dimen/album_cover_corner" />
        </shape>
    </item>
</layer-list>
